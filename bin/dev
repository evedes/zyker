#!/usr/bin/env sh
# Runs docker compose against the dev stack: bin/dev up -d --build, bin/dev logs -f app, ...
set -eu
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  echo "No .env found: copy .env.example to .env and adapt it to your environment." >&2
  exit 1
fi

exec docker compose -f docker-compose-dev.yaml "$@"
