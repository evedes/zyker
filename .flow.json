{
  "work_dir": "flow",
  "protected_paths": [
    "lib/",
    "test/",
    "config/",
    "priv/",
    "assets/",
    "mix.exs",
    "mix.lock"
  ],
  "standing_gates": [
    "mix compile --warnings-as-errors",
    "mix format --check-formatted",
    "mix test"
  ],
  "codegen": [
    "\\bmix\\s+(phx|ecto)\\.gen\\.\\S",
    "\\bmix\\s+igniter\\.\\S",
    "\\bmix\\s+format\\b(?!.*--check-formatted)"
  ],
  "reset": [
    "bin/dev run --rm -T app mix ecto.reset",
    "(cd ../zyker-cloud && bin/dev run --rm -T app mix ecto.reset)"
  ]
}
