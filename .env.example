# Template for docker-compose-dev.yaml settings: copy to .env (gitignored)
# and adapt it to your environment. This file is committed; keep it dev-only.

# Host ports (bound to 127.0.0.1)
APP_PORT=4000
DB_PORT=5439
S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zyker_dev

# SeaweedFS S3
S3_ACCESS_KEY_ID=zyker
S3_SECRET_ACCESS_KEY=zyker-dev-secret
S3_BUCKET=zyker-dev
